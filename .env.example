# Correspondence System — environment variables
# Copy to .env (or export in the deployment) and fill in real values.
# NOTHING secret should ever be committed; this file documents names only.

# --- Django core -----------------------------------------------------------
# Django secret key (sessions/signing). Required in production.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string

# Which settings module: config.settings.dev | config.settings.prod
# (manage.py defaults to dev; prod requires the variables marked [prod])
DJANGO_SETTINGS_MODULE=config.settings.dev

# [prod] Comma-separated allowed hosts, e.g. "correspondence.example.com"
ALLOWED_HOSTS=

# [prod] Comma-separated CORS origins of the frontend, e.g. "https://correspondence.example.com"
CORS_ALLOWED_ORIGINS=

# --- Database ---------------------------------------------------------------
# Dev default: sqlite (backend/db.sqlite3). [prod] PostgreSQL is required:
# DATABASE_URL=postgres://app:password@127.0.0.1:5432/correspondence
DATABASE_URL=

# --- Auth / tokens ----------------------------------------------------------
# HS256 key signing access tokens and MFA login-intent tokens.
# Dev default exists WITH A WARNING — set a real value outside dev.
AUTH_JWT_SECRET=

# Fernet key (base64, 32 bytes) wrapping users' TOTP secrets server-side.
# Dev default exists WITH A WARNING — set a real value outside dev.
# Production: KMS-managed, login-only data, separate from all E2EE keys.
AUTH_FERNET_KEY=

# Issuer name shown in authenticator apps for TOTP enrolment.
TOTP_ISSUER_NAME=مجموعة المعاهد

# --- Key transparency log ---------------------------------------------------
# Ed25519 seed (base64, exactly 32 bytes) signing the key-transparency log
# entries. This key protects the APPEND-ONLY PUBLIC chain (hashes only) —
# it never sees message content or private keys.
# Dev default exists WITH A WARNING — set a real value outside dev.
# Generate one with: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
CRYPTO_LOG_SIGN_SEED=

# [prod] Redirect HTTP to HTTPS (default true in prod settings).
SECURE_SSL_REDIRECT=true
