# /etc/correspondence/correspondence.env  — owner root, group correspondence, mode 0640
# Generate secrets with: sudo /opt/correspondence/deploy/scripts/gen-secrets.sh
# NEVER commit the real file. Losing CRYPTO_LOG_SIGN_SEED breaks verification of
# the existing key-transparency chain; keep an offline copy with the backups key.

DJANGO_SETTINGS_MODULE=config.settings.prod
PYTHONPATH=/opt/correspondence/backend

ALLOWED_HOSTS=mail.example.org
CORS_ALLOWED_ORIGINS=https://mail.example.org

# Runtime role (no UPDATE/DELETE on audit/transparency logs — see deploy/postgres/grants.sql)
DATABASE_URL=postgresql://corr_app:CHANGE_ME@localhost:5432/correspondence
# The OWNER role URL is deliberately NOT here: this file is loaded by the
# running app. Put it in /etc/correspondence/migrate.env (root:root 0600):
#   MIGRATE_DATABASE_URL=postgresql://corr_owner:CHANGE_ME@localhost:5432/correspondence

# Own db number (shared server: other apps usually use 0). preflight.sh checks it is empty.
REDIS_URL=redis://127.0.0.1:6379/5
ENCRYPTED_BLOB_ROOT=/var/lib/correspondence/blobs

DJANGO_SECRET_KEY=CHANGE_ME
AUTH_JWT_SECRET=CHANGE_ME
AUTH_FERNET_KEY=CHANGE_ME
CRYPTO_LOG_SIGN_SEED=CHANGE_ME

# Desktop notifications (Web Push). Empty key = feature off. Changing the key
# invalidates every browser subscription (users just click "enable" again).
# The server needs outbound HTTPS to the browsers' push services
# (fcm.googleapis.com, *.push.services.mozilla.com, *.notify.windows.com, *.push.apple.com).
WEB_PUSH_VAPID_PRIVATE_KEY=CHANGE_ME
WEB_PUSH_SUBJECT=mailto:it@example.org

# External (Internet) mail — empty domain = feature off. Inbound: MX of the
# domain -> this server, then deploy/scripts/install-mail.sh. Outbound: Brevo
# API key (never paste it in chat or commit it). Addresses: <mail name>@domain.
EXTERNAL_MAIL_DOMAIN=
BREVO_API_KEY=
# EXTERNAL_MAIL_DAILY_LIMIT=50        # outbound messages per employee per 24h
# CLAMD_SOCKET=/run/clamav/clamd.ctl  # virus-scan inbound attachments if clamav-daemon is installed

# Values with spaces MUST be double-quoted (read by systemd and by the shell scripts).
TOTP_ISSUER_NAME="مجموعة المعاهد"
LOG_LEVEL=INFO
# Optional limits
# ENCRYPTED_ATTACHMENT_MAX_BYTES=26214400
# KEY_BACKUP_MAX_BYTES=26214400   # encrypted recovery bundle per upload (≤ nginx client_max_body_size)
# ANNOUNCEMENT_MAX_RECIPIENTS=1000
